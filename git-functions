git config --global core.quotepath false  # Show non-askii filenames as they are instead of /xxx

# Add, commit and push all changes with a message
# Usage: gitpush "My commit message"
gitpush() {
  if [[ -z "$1" ]]; then
    echo "Usage: gitpush 'commit message'"
    return 1
  fi

  git add --all

  if ! git commit -m "$1"; then
    echo "❌ Commit was not created."
    return 1
  fi

  if ! git push; then
    echo "❌ Push failed."
    return 1
  fi

  echo "✅ Changes pushed to remote."
}

all_repos=(
  ~/dev/almasi
  ~/dev/o
  ~/dev/do
  ~/dev/yo
)

# Add, commit and push all core repos with the same message
# Usage: gitpushall 'My commit message'
gitpushall() {
  local message=$*
  local result=0

  if [[ -z ${message} ]]; then
    echo 'Usage: gitpushall <commit message>'
    result=1
  else
    for repo in ${all_repos}; do
      local repo_result=0
      local repo_name=${repo:t}
      local answer

      echo
      print -r -- '→' ${repo}

      if [[ ! -d ${repo}/.git ]]; then
        print -r -- '❌ Git repository not found:' ${repo}
        repo_result=1
      else
        read -r "answer?commit to ${repo_name}?: "

        if [[ ${answer} == y ]]; then
          git -C ${repo} add --all

          if [[ -n $(git -C ${repo} status --porcelain) ]]; then
            if ! git -C ${repo} commit --no-verify -m ${message}; then
              print -r -- '❌ Commit failed:' ${repo}
              repo_result=1
            fi
          else
            echo 'No changes to commit.'
          fi

          if [[ ${repo_result} == 0 ]]; then
            if ! git -C ${repo} push --no-verify; then
              print -r -- '❌ Push failed:' ${repo}
              repo_result=1
            fi
          fi
        else
          print -r -- 'Skipped' ${repo_name}
        fi
      fi

      if [[ ${repo_result} != 0 ]]; then
        result=1
      fi
    done
  fi

  if [[ ${result} == 0 ]]; then
    echo
    echo '✅ All repos pushed.'
  fi

  return ${result}
}

# Open the current Git repository in browser (GitHub, GitLab, etc.)  
# Usage: gitopen [optional_path]
gitopen() {
  local targetDir="${1:-.}"

  # Find .git directory upwards
  while [ ! -d "$targetDir/.git" ]; do
    local parent="$(dirname "$targetDir")"
    if [ "$parent" = "$targetDir" ]; then
      echo "❌ No .git directory found."
      return 1
    fi
    targetDir="$parent"
  done

  # Get origin remote URL
  local remoteUrl
  remoteUrl="$(git -C "$targetDir" remote get-url origin 2>/dev/null)"
  if [ -z "$remoteUrl" ]; then
    echo "❌ No 'origin' remote found."
    return 1
  fi

  # Convert SSH URL to HTTPS and clean up .git suffix
  if [[ "$remoteUrl" =~ ^git@([^:]+):([^/]+)/(.+)\.git$ ]]; then
    remoteUrl="https://${BASH_REMATCH[1]}/${BASH_REMATCH[2]}/${BASH_REMATCH[3]}"
  else
    remoteUrl="${remoteUrl%.git}"
  fi

  # Open in browser
  if command -v xdg-open >/dev/null; then
    xdg-open "$remoteUrl"
  elif command -v open >/dev/null; then
    open "$remoteUrl"
  else
    echo "Cannot detect browser command. Open manually:"
    echo "$remoteUrl"
  fi
}

# Install or remove local git hooks from scripts/git-hooks  
# Usage: git_set_hooks true    → install hooks  
#        git_set_hooks false   → remove hooks  
git_set_hooks() {
  local action="$1"
  local hooks_dir="$HOME/scripts/git-hooks"
  local target_dir="$HOME/.git-hooks"

  if [[ "$action" == "true" ]]; then
    [[ ! -d "$hooks_dir" ]] && echo "❌ Hooks dir '$hooks_dir' not found." && return 1
    mkdir -p "$target_dir"
    cp -R "$hooks_dir/"* "$target_dir/"
    echo "✅ Git hooks installed to $target_dir"
  elif [[ "$action" == "false" ]]; then
    [[ -d "$target_dir" ]] && rm -rf "$target_dir" && echo "❎ Git hooks removed from $target_dir"
  else
    echo "Usage: git_set_hooks true|false"
    return 1
  fi
}
# Commit and push listed repositories without changing the current shell.
# ----------------------------------------------------------------------
bgitpush() {
	emulate -L zsh
	unsetopt bg_nice
	local repos_file=~/bulk_commit_repos.txt
	local message=${1-}
	local result=0
	local width=0
	local count_width=6
	local interactive=0
	local repo repo_name row files commits outcome timestamp color line
	local index total
	local -aU repos

	if (( $# == 1 )) && [[ -n ${message} && -r ${repos_file} ]]; then
		while IFS= read -r repo || [[ -n ${repo} ]]; do
			repo=${repo%$'\r'}
			if [[ -n ${repo} ]]; then
				if [[ ${repo} == '~/'* ]]; then
					repo=${HOME}/${repo#\~/}
				fi
				repos+=(${repo})
				repo_name=${${repo%/}:t}
				if (( ${#repo_name} > width )); then
					width=${#repo_name}
				fi
			fi
		done < ${repos_file}
		(( width += 2 ))
		total=${#repos}

		if [[ -t 1 && ${TERM-} != dumb ]] && (( total + 2 < ${LINES:-24} && width + count_width + 24 < ${COLUMNS:-80} )); then
			interactive=1
			for repo in ${repos}; do
				repo_name=${${repo%/}:t}
				printf '\033[1;33m%-*s\033[0;90m…\033[0m\n' ${width} ${repo_name}
			done
		fi

		{
			for (( index=1; index <= total; index++ )); do
				(
					local changes
					local files=0 commits=0 outcome=0
					export GIT_TERMINAL_PROMPT=0 GCM_INTERACTIVE=Never
					export GIT_SSH_COMMAND='ssh -o BatchMode=yes'

					if (
						setopt pipefail
						cd -- ${repos[index]} &&
						changes=$(git status --porcelain) &&
						{ [[ -z ${changes} ]] || { git add --all && git -c core.askPass=false commit --no-verify -m ${message}; }; } &&
						commits=$(git rev-list --count HEAD --not --remotes) &&
						{
							if (( commits > 0 )); then
								files=$(git log --format= --name-only HEAD --not --remotes | sort -u | awk 'NF { count++ } END { print count + 0 }') &&
								git -c core.askPass=false push --no-verify
							fi
						} &&
						printf '%s\t%s\t%s\t0\n' ${index} ${files} ${commits} >&3
					) 3>&1 >/dev/null 2>&1; then
						:
					else
						printf '%s\tfailed\t0\t1\n' ${index}
					fi
				) &
			done
			wait
		} | while IFS=$'\t' read -r row files commits outcome; do
			repo=${repos[row]}
			repo_name=${${repo%/}:t}
			if (( outcome )); then
				result=1
			fi
			color=$'\033[0;90m'
			if [[ ${files} != failed ]] && (( files > 0 )); then
				color=$'\033[0;1;97m'
			fi
			line=$(printf '\033[1;33m%-*s%s%-*s' ${width} ${repo_name} ${color} ${count_width} ${files})
			if (( commits > 0 )); then
				line+=$(printf '\033[0;90m  %s commits' ${commits})
			fi
			if (( interactive )); then
				printf '\0337\033[%sA\r\033[2K%s\033[0m\0338' $(( total - row + 1 )) ${line}
			else
				printf '%s\033[0m\n' ${line}
			fi
		done

		timestamp=$(date '+%B %-d, %Y at %-I:%M %p %Z')
		printf '\n\033[0;90m%s\033[0m\n' ${timestamp}
	else
		print -r -- 'bgitpush requires a commit message and ~/bulk_commit_repos.txt' >&2
		result=1
	fi

	return ${result}
}

# Show changed-file counts for the bulk repository list.
# ----------------------------------------------------------------------
bgitstatus() {
	local repos_file=~/bulk_commit_repos.txt
	local result=0
	local repo repo_name changes files noun
	local -a entries

	if [[ -r ${repos_file} ]]; then
		while IFS= read -r repo || [[ -n ${repo} ]]; do
			repo=${repo%$'\r'}
			if [[ -n ${repo} ]]; then
				if [[ ${repo} == '~/'* ]]; then
					repo=${HOME}/${repo#\~/}
				fi
				repo_name=${${repo%/}:t}

				if changes=$(git -C ${repo} --no-optional-locks status --porcelain --untracked-files=all 2>/dev/null); then
					if [[ -n ${changes} ]]; then
						entries=(${(f)changes})
						files=${#entries}
						noun=file
						if (( files != 1 )); then
							noun=files
						fi
						printf '📝 \033[1;33m%s\033[0;90m %s changed %s\033[0m\n' ${repo_name} ${files} ${noun}
					else
						printf '✅ \033[1;33m%s\033[0;90m clean\033[0m\n' ${repo_name}
					fi
				else
					printf '❌ \033[1;33m%s\033[0;90m failed to read status\033[0m\n' ${repo_name}
					result=1
				fi
			fi
		done < ${repos_file}
	else
		print -r -- 'bgitstatus requires ~/bulk_commit_repos.txt' >&2
		result=1
	fi

	return ${result}
}

# Pull fast-forward updates for the bulk repository list.
# ----------------------------------------------------------------------
bgitpull() {
	emulate -L zsh
	unsetopt bg_nice
	local repos_file=~/bulk_commit_repos.txt
	local result=0
	local width=0
	local count_width=6
	local interactive=0
	local repo repo_name row files commits outcome timestamp color line
	local index total
	local -aU repos

	if [[ -r ${repos_file} ]]; then
		while IFS= read -r repo || [[ -n ${repo} ]]; do
			repo=${repo%$'\r'}
			if [[ -n ${repo} ]]; then
				if [[ ${repo} == '~/'* ]]; then
					repo=${HOME}/${repo#\~/}
				fi
				repos+=(${repo})
				repo_name=${${repo%/}:t}
				if (( ${#repo_name} > width )); then
					width=${#repo_name}
				fi
			fi
		done < ${repos_file}
		(( width += 2 ))
		total=${#repos}

		if [[ -t 1 && ${TERM-} != dumb ]] && (( total + 2 < ${LINES:-24} && width + count_width + 24 < ${COLUMNS:-80} )); then
			interactive=1
			for repo in ${repos}; do
				repo_name=${${repo%/}:t}
				printf '\033[1;33m%-*s\033[0;90m…\033[0m\n' ${width} ${repo_name}
			done
		fi

		{
			for (( index=1; index <= total; index++ )); do
				(
					local before after
					local files=0 commits=0 outcome=0
					export GIT_TERMINAL_PROMPT=0 GCM_INTERACTIVE=Never
					export GIT_SSH_COMMAND='ssh -o BatchMode=yes'

					if (
						cd -- ${repos[index]} &&
						before=$(git rev-parse HEAD) &&
						git -c core.askPass=false -c core.hooksPath=/dev/null pull --ff-only --no-rebase --no-autostash &&
						after=$(git rev-parse HEAD) &&
						commits=$(git rev-list --count ${before}..${after}) &&
						files=$(git diff --numstat ${before} ${after} | awk 'END { print NR }') &&
						printf '%s\t%s\t%s\t0\n' ${index} ${files} ${commits} >&3
					) 3>&1 >/dev/null 2>&1; then
						:
					else
						printf '%s\tfailed\t0\t1\n' ${index}
					fi
				) &
			done
			wait
		} | while IFS=$'\t' read -r row files commits outcome; do
			repo=${repos[row]}
			repo_name=${${repo%/}:t}
			if (( outcome )); then
				result=1
			fi
			color=$'\033[0;90m'
			if [[ ${files} != failed ]] && (( files > 0 )); then
				color=$'\033[0;1;97m'
			fi
			line=$(printf '\033[1;33m%-*s%s%-*s' ${width} ${repo_name} ${color} ${count_width} ${files})
			if (( commits > 0 )); then
				line+=$(printf '\033[0;90m  %s commits' ${commits})
			fi
			if (( interactive )); then
				printf '\0337\033[%sA\r\033[2K%s\033[0m\0338' $(( total - row + 1 )) ${line}
			else
				printf '%s\033[0m\n' ${line}
			fi
		done

		timestamp=$(date '+%B %-d, %Y at %-I:%M %p %Z')
		printf '\n\033[0;90m%s\033[0m\n' ${timestamp}
	else
		print -r -- 'bgitpull requires ~/bulk_commit_repos.txt' >&2
		result=1
	fi

	return ${result}
}

# Show the bulk repository file and its configured repositories.
# ----------------------------------------------------------------------
bgitlist() {
	local repos_file=~/bulk_commit_repos.txt
	local result=0
	local repo repo_name

	printf '📋 \033[1;33m%s\033[0m\n' ${repos_file}

	if [[ -r ${repos_file} ]]; then
		while IFS= read -r repo || [[ -n ${repo} ]]; do
			repo=${repo%$'\r'}
			if [[ -n ${repo} ]]; then
				repo_name=${${repo%/}:t}
				printf '📁 \033[1;33m%s\033[0;90m %s\033[0m\n' ${repo_name} ${repo}
			fi
		done < ${repos_file}
	else
		printf '❌ \033[0;90mfailed to read repository list\033[0m\n' >&2
		result=1
	fi

	return ${result}
}

# Create a private Python repository and open its local checkout.
# ----------------------------------------------------------------------
git-project() {
	local name=${1-}
	local result=0

	if (( $# == 1 )) && [[ ${name} =~ '^[A-Za-z0-9][A-Za-z0-9._-]*$' && ${name} != *.git ]]; then
		if [[ ! -e ${name} && ! -L ${name} ]]; then
			if command -v gh >/dev/null && command -v git >/dev/null && command -v code >/dev/null; then
				if gh auth setup-git --hostname github.com && gh repo create ${name} --private --gitignore Python --clone && cd -- ${name} && code .; then
					result=0
				else
					result=$?
				fi
			else
				print -r -- 'git-project requires gh, git and code on PATH.' >&2
				result=1
			fi
		else
			print -r -- 'Local destination already exists: '${name} >&2
			result=1
		fi
	else
		print -r -- 'Usage: git-project <name> (letters, numbers, dots, underscores or hyphens; no .git suffix)' >&2
		result=1
	fi

	return ${result}
}
