typeset _llm_aliases_enabled=${options[aliases]}
unsetopt aliases

# ======================================================================
# LLM
# ======================================================================

function llm_get_running_models() {
	ollama ps | awk 'NR > 1 && $1 != "" {print $1}'
}

function llm_get_models() {
	ollama list | awk 'NR > 1 && $1 != "" {print $1}'
}

function llm_select_lines() {
	local lines
	local selected_id
	local count
	local selected

	lines="$(cat)"
	count="$(printf '%s\n' "$lines" | awk 'NF {count++} END {print count + 0}')"

	if [[ "$count" = "0" ]]; then
		return 1
	fi

	printf '%s\n' "$lines" | awk '{print NR ") " $0}' >&2

	printf 'Select [1-%s]: ' "$count" >&2
	read -r selected_id < /dev/tty

	selected="$(printf '%s\n' "$lines" | awk -v selected_id="$selected_id" 'NR == selected_id {print}')"

	if [[ -z "$selected" ]]; then
		echo "[🔴] Invalid choice" >&2
		return 1
	fi

	echo "$selected"
}

function llm_select_model() {
	local model

	if [[ -z "$(llm_get_models)" ]]; then
		echo "[🔴] No Ollama models found"
		return 1
	fi

	model="$(llm_get_models | llm_select_lines)" || return 1
	echo "$model"
}


function llm_kill_model() {
	local running_models
	local model
	local count

	running_models="$(llm_get_running_models)"

	if [[ -z "$running_models" ]]; then
		echo "No model is running"
		return 0
	fi

	count="$(printf '%s\n' "$running_models" | wc -l | tr -d ' ')"

	if [[ "$count" = "1" ]]; then
		model="$running_models"
	else
		model="$(printf '%s\n' "$running_models" | llm_select_lines)" || return 1
	fi

	ollama stop "$model" > /dev/null
	echo "🔴 Stopped $model"
}

function llm_running_menu() {
	local selected_id

	echo "🟢 Running:"
	echo "------------------------------------------------------------"
	ollama ps
	echo "------------------------------------------------------------"
	echo "1) kill"
	echo "2) keep alive"
	printf 'Select [1-2]: '
	read -r selected_id < /dev/tty
	echo "------------------------------------------------------------"

	if [[ "$selected_id" = "1" ]]; then
		llm_kill_model
	elif [[ "$selected_id" = "2" ]]; then
		echo "🟢 Continue running"
	else
		echo "[🔴] Invalid choice"
		return 1
	fi
	echo "------------------------------------------------------------"
}

function llm() {
	local running_models
	local model

	running_models="$(llm_get_running_models)"

	echo "------------------------------------------------------------"

	if [[ -n "$running_models" ]]; then
		llm_running_menu
	else
		model="$(llm_select_model)" || return 1
		curl -fsS http://localhost:11434/api/generate \
			-d '{"model":"'"$model"'","prompt":"","keep_alive":-1}' \
			> /dev/null

		echo "------------------------------------------------------------"
		echo "🟢 Running $model"
		echo "------------------------------------------------------------"
		ollama ps
	fi
}
# Check configured models using the current environment credentials.
# ----------------------------------------------------------------------
llmping() {
	local models_file=~/scripts/models.txt
	local result=0
	local line provider model key url payload response body code elapsed answer state curl_result
	local -a entries models headers

	if [[ -r ${models_file} ]] && command -v curl >/dev/null && command -v jq >/dev/null; then
		while IFS= read -r line || [[ -n ${line} ]]; do
			entries=(${=line%%#*})
			if (( ${#entries} )); then
				if (( ${#entries} == 2 )) && [[ ${entries[1]} == (gemini|local|cloud) ]]; then
					models+=(${entries[1]} ${entries[2]})
				else
					print -r -- 'Invalid models.txt entry: '${line} >&2
					result=1
				fi
			fi
		done < ${models_file}

		if (( result == 0 )); then
			printf '%-10s %-34s %-16s %8s  %s\n' PROVIDER MODEL STATUS SECONDS 'RESPONSE / ERROR'
			while (( ${#models} )); do
				provider=${models[1]}
				model=${models[2]}
				models[1,2]=()
				headers=(-H 'Content-Type: application/json')
				key=''
				if [[ ${provider} == gemini ]]; then
					key=${GEMINI_API_KEY:-${GOOGLE_API_KEY-}}
					url=https://generativelanguage.googleapis.com/v1beta/models/${model}:generateContent
					headers+=(-H x-goog-api-key:${key})
					payload='{"contents":[{"parts":[{"text":"Reply with exactly PONG"}]}],"generationConfig":{"maxOutputTokens":1024}}'
				else
					url=${OLLAMA_HOST:-http://localhost:11434}/api/chat
					if [[ ${provider} == cloud ]]; then
						key=${OLLAMA_API_KEY-}
						url=https://ollama.com/api/chat
						headers+=(-H 'Authorization: Bearer '${key})
					fi
					payload=$(jq -cn --arg model ${model} '{model:$model,messages:[{role:"user",content:"Reply with exactly PONG"}],stream:false,options:{num_predict:32}}')
				fi

				state=NO_KEY
				answer='Missing provider API key'
				elapsed=0
				if [[ ${provider} == local || -n ${key} ]]; then
					curl_result=0
					response=$(curl --disable -sS --connect-timeout 10 --max-time 30 ${headers} --data-binary ${payload} -w $'\n%{http_code}\n%{time_total}' ${url} 2>&1) || curl_result=$?
						elapsed=${response##*$'\n'}
						body=${response%$'\n'*}
						code=${body##*$'\n'}
						body=${body%$'\n'*}
						if (( curl_result == 0 )); then
							if [[ ${code} == 2[0-9][0-9] ]]; then
								if answer=$(print -r -- ${body} | jq -er 'if .candidates then [.candidates[]?.content.parts[]?.text // empty] | join(" ") else .message.content // "" end' 2>/dev/null); then
									state=OK
									if [[ -z ${answer//[[:space:]]/} ]]; then
										state=EMPTY
										answer=$(print -r -- ${body} | jq -r '.promptFeedback.blockReason // .candidates[0].finishReason // "No text response"')
									fi
								else
									state=INVALID_RESPONSE
									answer='Invalid provider response'
								fi
							else
								state=HTTP_${code}
								answer=${body}
							fi
					else
						state=UNAVAILABLE
						if (( curl_result == 28 )); then
							state=TIMEOUT
						fi
						answer=${body}
					fi
				fi
				answer=${answer//$'\n'/ }
				printf '%-10s %-34s %-16s %8s  %s\n' ${provider} ${model} ${state} ${elapsed} ${answer[1,160]}
			done
		fi
	else
		print -r -- 'llmping requires curl, jq and ~/scripts/models.txt' >&2
		result=1
	fi

	return ${result}
}

[[ ${_llm_aliases_enabled} == on ]] && setopt aliases
unset _llm_aliases_enabled
